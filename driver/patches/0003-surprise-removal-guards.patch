+
 	if (active == _TRUE) {
 #ifdef CONFIG_80211N_HT
 		/* tear down Rx AMPDU */
diff --git a/core/rtw_cmd.c b/core/rtw_cmd.c
index f2055b7..317325d 100644
--- a/core/rtw_cmd.c
+++ b/core/rtw_cmd.c
