 {
 	u8 bAllow = _FALSE; /* set to _TRUE to allow enqueuing cmd when hw_init_completed is _FALSE */
 
+	/*
+	 * jmk-wifi: once the device is gone the command thread drops every queued
+	 * command without running it. Refuse new ones here instead, so callers that
